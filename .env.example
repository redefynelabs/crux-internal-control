# The control plane's own database (leads, demos).
CP_DATABASE_URL=postgres://controlplane:change-me@localhost:5432/controlplane?sslmode=disable
CP_LISTEN=:8090
# Browsers allowed to call POST /v1/demo-requests (the marketing site), comma separated.
CP_ALLOWED_ORIGINS=https://www.example.com
# true when a reverse proxy sets X-Forwarded-For.
CP_TRUST_PROXY=true
# A Slack-style webhook told about each new lead, message and demo. Empty: no notifications.
CP_NOTIFY_WEBHOOK_URL=
# Cloudflare Turnstile secret. Empty: no captcha.
CP_TURNSTILE_SECRET=

# --- demos ---
CP_DEMO_DOMAIN=demo.example.com
CP_DEMO_SCHEME=https
CP_DEMO_TTL=1h
CP_MAX_DEMOS=20
# Visitors who ask while every room is busy wait in line (needs working email); 0 turns waiting off.
CP_DEMO_QUEUE_MAX=30
CP_DEMO_QUEUE_WAIT=24h
CP_DEMO_PER_EMAIL_24H=2
CP_DEMO_PER_IP_24H=5
CP_SERVER_IMAGE=ghcr.io/your-org/erp-server:v1.0.0
CP_WEB_IMAGE=ghcr.io/your-org/erp-web:v1.0.0
CP_DEMO_MEMORY=384m
CP_DEMO_CPUS=0.5
# Mei in a demo, answered with OUR AI key (a cheap model) and a small allowance per demo. Set a spend limit on the key at
# the provider as well. Empty key: Mei cannot answer in demos.
CP_DEMO_AI_PROVIDER=
CP_DEMO_AI_MODEL=
CP_DEMO_AI_API_KEY=
CP_DEMO_AI_MAX_QUESTIONS=15
# Entitlements: the Ed25519 key that signs what each installation may use (controlplane keygen). Outside the repository
# and any backup that leaves the server, readable only by its owner. Empty: nothing can be issued.
CP_ENTITLEMENT_KEY_FILE=
# The industry template named in the entitlement each demo is given.
CP_DEMO_ENTITLEMENT_TEMPLATE=agency
# A role that may create and drop databases on the demo Postgres (connect to the postgres database).
CP_PG_ADMIN_URL=postgres://postgres:change-me@localhost:5432/postgres?sslmode=disable
# How a demo's server container reaches that Postgres, and the role it uses (the owner of every demo database).
CP_PG_HOST=postgres:5432
CP_PG_USER=erp_demo
CP_PG_PASSWORD=
CP_DEMO_TEMPLATE=erp_demo_seed
CP_REDIS_URL=redis://redis:6379/1
# Docker networks: the one Postgres and Redis are on, and the one Traefik is on.
CP_DATA_NETWORK=erp-data
CP_PROXY_NETWORK=erp-proxy
CP_TRAEFIK_ENTRYPOINT=websecure
# "none": no certificate, plain HTTP (local trials only; also set CP_DEMO_SCHEME=http and CP_TRAEFIK_ENTRYPOINT=web).
CP_TRAEFIK_CERT_RESOLVER=letsencrypt

# --- team and email ---
# The first admin, created on the first start when nobody exists yet (required then; at least 10 characters). There is
# no shared token: everyone signs in with their own email and password.
CP_ADMIN_EMAIL=
CP_ADMIN_PASSWORD=
CP_ADMIN_NAME=Admin
# The public address of the admin app. Invitation emails link to it. Empty: invite links are shown on screen only.
# The marketing site, used for the "start a demo" and "pricing" buttons in designed emails.
CP_SITE_URL=https://www.example.com
CP_ADMIN_URL=
# Encrypts the SMTP password saved in Settings. Required, at least 32 characters (openssl rand -hex 32). Changing it
# means entering the SMTP password again.
CP_SECRETS_KEY=
