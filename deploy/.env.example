# One server for the control plane and the demos. Copy to .env and fill it in; keep it out of git (chmod 600).

# --- addresses ---------------------------------------------------------------------------------------------------
# Your domain. By default admin.<it> is the admin app, api.<it> is what the marketing site calls, and every demo opens at
# <slug>.demo.<it>. DNS: A records for admin, api and *.demo pointing at this server.
BASE_DOMAIN=example.com
# Optional: name the three addresses yourself instead (each defaults as above). The wildcard certificate covers exactly these.
# ADMIN_HOST=internal.example.com
# API_HOST=api.internal.example.com
# DEMO_DOMAIN=demo.example.com     # demos open at <slug>.<DEMO_DOMAIN>
# Where Let's Encrypt writes about the certificate.
ACME_EMAIL=you@example.com
# The DNS host that holds BASE_DOMAIN, as Traefik names it (cloudflare, gcloud, route53, digitalocean ...), with its
# credentials in acme.env. A wildcard certificate can only be issued through the DNS.
ACME_DNS_PROVIDER=cloudflare

# --- images ------------------------------------------------------------------------------------------------------
CONTROLPLANE_IMAGE=ghcr.io/your-org/erp-control-plane:v1.0.0
ADMIN_IMAGE=ghcr.io/your-org/erp-control-plane-web:v1.0.0
# What every demo runs: the ERP's server and web images.
CP_SERVER_IMAGE=ghcr.io/your-org/erp-server:v1.0.0
CP_WEB_IMAGE=ghcr.io/your-org/erp-web:v1.0.0
# Builds the demo template (migrate and the sample company); used once per release by build-template.sh.
ERP_DEMO_TOOLS_IMAGE=ghcr.io/your-org/erp-demo-tools:v1.0.0
# The numeric id of the docker group on this server: getent group docker | cut -d: -f3
DOCKER_GID=999

# --- database passwords (make each with: openssl rand -hex 24) ---------------------------------------------------
PG_ADMIN_PASSWORD=
CP_DB_PASSWORD=
DEMO_ROLE_PASSWORD=

# --- control plane (see ../.env.example for the full list) --------------------------------------------------------
CP_SECRETS_KEY=
CP_ADMIN_EMAIL=
CP_ADMIN_PASSWORD=
CP_ADMIN_NAME=Admin
# The marketing site, which may call the API from a browser.
CP_ALLOWED_ORIGINS=https://www.example.com
# Size this to the server: about 5 on 4 GB, about 10 on 8 GB (2 cores), about 24 on 16 GB. See README.
CP_MAX_DEMOS=10
CP_DEMO_TTL=1h
# When every demo room is busy, visitors wait in line and are emailed their login when a room frees up (needs working email
# under Settings → Email). At most this many wait (0: nobody waits, they are asked to try later), for at most this long.
CP_DEMO_QUEUE_MAX=30
CP_DEMO_QUEUE_WAIT=24h
CP_DEMO_MEMORY=384m
CP_DEMO_CPUS=0.5
CP_DEMO_PER_EMAIL_24H=2
CP_DEMO_PER_IP_24H=5
CP_TURNSTILE_SECRET=
CP_NOTIFY_WEBHOOK_URL=
# Mei in demos, answered with your own key. Set a spend limit on that key at the provider first.
CP_DEMO_AI_PROVIDER=
CP_DEMO_AI_MODEL=
CP_DEMO_AI_API_KEY=
CP_DEMO_AI_MAX_QUESTIONS=15
# Entitlements: the Ed25519 key that signs what each installation may use (controlplane keygen). Outside the repository
# and any backup that leaves the server, readable only by its owner. Empty: nothing can be issued.
# (the compose file mounts ./keys at /keys and sets CP_ENTITLEMENT_KEY_FILE)
# The industry template named in the entitlement each demo is given.
CP_DEMO_ENTITLEMENT_TEMPLATE=agency

# --- one-line installer for customers ---
# This service's public address (the one customers can reach): the installer script and the customer page use it.
CP_PUBLIC_URL=https://api.example.com
# The marketing site: the "start a demo" and "pricing" buttons in designed emails go to {CP_SITE_URL}/demo and /pricing.
CP_SITE_URL=https://www.example.com
# Where the images are, and a login that may only READ them (empty user and token when the images are public).
# Letters, digits and . _ : / @ + - only: these are written into a script the customer runs.
CP_INSTALL_REGISTRY=ghcr.io/your-org
CP_INSTALL_REGISTRY_USER=
CP_INSTALL_REGISTRY_TOKEN=
